<odoo>
    <record id="tripletex_customer_load_form_view" model="ir.ui.view">
        <field name="name">tripletex.customer.load.form.view</field>
        <field name="model">tripletex.customer.load</field>
        <field name="arch" type="xml">
            <form >
                 <p style="text-align:center;">
                <p>This functionality will map Odoo Customer with Tripletex Customer if they both have the same name and email.</p>
                <group >
                    <button name="customer_data_get" string="Sync Customer to Odoo" class="oe_highlight" type="object"/>
                </group>
                <br/>
                <p>This functionality will create Customer from Tripletex to odoo.</p>
                <group>
                    <button name="import_customer_from_tripletex" string="Import Customers from Tripletex" class="oe_highlight" type="object"/>
                </group>
                     <br/>
                     <p>This functionality will create Customer from Odoo to Tripletex.</p>
                <group>
                    <button name="import_customer_from_odoo" string="Import Customers from Odoo" class="oe_highlight" type="object"/>
                </group>
                </p>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
    <record id="action_tripletex_customer_load" model="ir.actions.act_window">
        <field name="name">Customer Data</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tripletex.customer.load</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
