<odoo>
    <record id="tripletex_product_load_form_view" model="ir.ui.view">
        <field name="name">tripletex.product.map.form</field>
        <field name="model">tripletex.product.map</field>
        <field name="arch" type="xml">
            <form string="Product Sync">
                <p style="text-align:center;">
                    <p>This functionality will update Product Id in Tripletex to Odoo if both share the same Odoo
                        default code and Tripletex number.
                    </p>
                   <group>
                        <button string="Product Sync to Odoo" class="oe_highlight" type="object"
                                name="product_sync" icon="fa-file"/>
                    </group>
                    <br/>
                    <p>This functionality will import products from Tripletex to Odoo if the product is not in Odoo.
                    </p>
                    <group>
                        <button string="Import Product from Tripletex" class="oe_highlight" type="object"
                                name="import_products_from_tripletex" icon="fa-file"/>
                    </group>
                     <br/>
                    <p>This functionality will import products from Odoo to Tripletex if the product is absent in Tripletex.
                    </p>
                    <group>
                        <button string="Import Product from Odoo" class="oe_highlight" type="object"
                                name="import_products_from_odoo" icon="fa-file"/>
                    </group>
                </p>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tripletex_product_map" model="ir.actions.act_window">
        <field name="name">Products Sync</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tripletex.product.map</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>