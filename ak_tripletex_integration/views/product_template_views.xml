<odoo>
    <!-- Inherit for add fields -->
    <record id="ak_tripletex_integration_inherit_product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field name="tripletex_product" string="Product ID" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
            </xpath>
            <field name="default_code" position="attributes">
                <attribute name="required">1</attribute>
            </field>
        </field>
    </record>
    <record id="ak_tripletex_integration_inherit_product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type']" position="after">
                <filter string="Tripletex Synced" name="tripletex_synced"
                        domain="[('tripletex_product', '!=', False)]"/>
                <filter string="Odoo Products" name="odoo_product_only"
                        domain="[('tripletex_product', '=', False)]"/>
            </xpath>
        </field>
    </record>
    <record id="sale.product_template_action" model="ir.actions.act_window">
        <field name="context">{'search_default_tripletex_synced': 1}</field>
    </record>
    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="context">{'search_default_tripletex_synced': 1}</field>
    </record>
    <record id="ak_tripletex_integration_inherit_product_product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.normal.form.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field name="tripletex_product" string="Product ID" readonly="1"/>
            </xpath>
            <field name="default_code" position="attributes">
                <attribute name="required">1</attribute>
            </field>
        </field>
    </record>
</odoo>
