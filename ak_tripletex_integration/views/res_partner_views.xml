<odoo>
    <!-- Inherit for add fields -->
    <record id="ak_tripletex_invoice_inherit_view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_address_format']" position="after">
                <field name="is_hidden" widget="boolean_toggle"/>
                <field name="trip_customer" invisible="not is_hidden" readonly="1"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="customer_number" invisible="supplier_rank and not customer_rank" readonly="1"/>
                <field name="supplier_number" invisible="customer_rank and not supplier_rank" readonly="1"/>
            </xpath>
            <field name="email" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <xpath expr="//field[@name='website']" position="before">
                <field name="alternate_email" widget="email" invisible="supplier_rank and not customer_rank"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">

                <page string="Tripletex">
                    <group>
                        <group invisible="company_type == 'person'">
                            <span class="o_form_label o_td_label o_address_type">
                                <span>Business Address</span>
                            </span>
                            <div class="o_address_format">
                                <field name="business_street" placeholder="Street..." class="o_address_street"
                                       readonly="type == 'contact' and parent_id"/>
                                <field name="business_street2" placeholder="Street 2..." class="o_address_street"
                                       readonly="type == 'contact' and parent_id"/>
                                <field name="business_city" placeholder="City" class="o_address_city"
                                       readonly="type == 'contact' and parent_id"/>
                                <field name="business_zip" placeholder="ZIP" class="o_address_zip"
                                       readonly="type == 'contact' and parent_id"/>
                                <div name="partner_address_country" class="d-flex justify-content-between">
                                    <field name="business_country_id" placeholder="Country"
                                           class="o_address_country"
                                           options='{"no_open": True, "no_create": True}'
                                           readonly="type == 'contact' and parent_id"/>
                                </div>
                            </div>
                        </group>
                        <group string="Automatic reminders" invisible="supplier_rank and not customer_rank">
                            <field name="is_soft_reminder"/>
                            <field name="is_reminder"/>
                            <field name="is_notice_od_debt"/>
                        </group>
                    </group>
                    <group string="Invoice Setting" invisible="supplier_rank and not customer_rank ">
                        <group>
                            <field name="due_date"/>
                            <field name="invoices_due_in_type_ui"/>
                            <field name="invoices_due_in_type" invisible="1"/>
                            <field name="discountPercentage"/>
                            <field name="is_single_customer_invoice"/>
                        </group>
                        <group>
                            <field name="email_attachment_type"/>
                            <field name="send_invoice_via"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
