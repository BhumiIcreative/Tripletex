<odoo>
    <record id="tripletex_contact_sync_form_view" model="ir.ui.view">
        <field name="name">tripletex.contact.sync.form.view</field>
        <field name="model">tripletex.contact.sync</field>
        <field name="arch" type="xml">
             <form string="Contact Sync">
                <p style="text-align:center;">
                    <p>This functionality will update contact in Tripletex from Odoo.
                    </p>
                   <group>
                        <button string="Contact Sync" class="oe_highlight" type="object"
                                name="contacts_sync" icon="fa-file"/>
                    </group>
                    <br/>
                    <p>This functionality will import contact from Tripletex to Odoo.
                    </p>
                    <group>
                        <button string="Import Contact from Tripletex" class="oe_highlight" type="object"
                                name="import_contacts_from_tripletex" icon="fa-file"/>
                    </group>
                     <br/>
                    <p>This functionality will import contact from Odoo to Tripletex.
                    </p>
                    <group>
                        <button string="Import Contact from Odoo" class="oe_highlight" type="object"
                                name="import_contacts_from_odoo" icon="fa-file"/>
                    </group>
                </p>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_tripletex_contact_sync" model="ir.actions.act_window">
        <field name="name">Contact Sync</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tripletex.contact.sync</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
