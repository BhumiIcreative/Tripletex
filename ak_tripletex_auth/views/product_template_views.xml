<odoo>
    <record id="ak_tripletex_auth_inherit_product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field name="tripletex_product" string="Product ID"/>
            </xpath>
        </field>
    </record>
    <record id="ak_tripletex_auth_inherit_product_product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.normal.form.view</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field name="tripletex_product" string="Product ID"/>
            </xpath>
        </field>
    </record>
</odoo>
