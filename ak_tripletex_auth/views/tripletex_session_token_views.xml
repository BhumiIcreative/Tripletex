<odoo>
    <record id="tripletex_session_token_list_view" model="ir.ui.view">
        <field name="name">tripletex.session.token.list.view</field>
        <field name="model">tripletex.session.token</field>
        <field name="arch" type="xml">
            <list string="Tripletex Session Token">
                <field name="token"/>
                <field name="expiration_date"/>
            </list>
        </field>
    </record>
    <record id="tripletex_session_token_form_view" model="ir.ui.view">
        <field name="name">tripletex.session.create.form.view</field>
        <field name="model">tripletex.session.token</field>
        <field name="arch" type="xml">
            <form string="Tripletex Session Token">
                <header>
                    <button name="%(ak_tripletex_auth.action_session_token_wizard)d" string="Token Create"
                            type="action"/>
                </header>
                <sheet>
                    <group style="text-align:center" string="Create Token"/>
                    <group>
                        <group>
                            <field name="token"/>
                            <field name="expiration_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_tripletex_session_token" model="ir.actions.act_window">
        <field name="name">Create Token</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">tripletex.session.token</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
