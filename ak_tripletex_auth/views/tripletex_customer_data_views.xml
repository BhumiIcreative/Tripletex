<odoo>
    <data>
        <record id="tripletex_customer_list_view" model="ir.ui.view">
            <field name="name">tripletex.consumer.list</field>
            <field name="model">tripletex.consumer</field>
            <field name="arch" type="xml">
                <list string="Tripletex Customer Data">
                    <field name="tripletex"/>
                    <field name="name"/>
                    <field name="organization_no"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="is_company_private"/>
                </list>
            </field>
        </record>
        <!-- Form view for tripletex.consumer -->
        <record id="tripletex_customer_form_view" model="ir.ui.view">
            <field name="name">tripletex.consumer.form</field>
            <field name="model">tripletex.consumer</field>
            <field name="arch" type="xml">
                <form string="Tripletex Customer Data">
                    <sheet>
                        <group>
                            <field name="tripletex"/>
                            <field name="name"/>
                            <field name="organization_no"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="is_company_private" widget="boolean_toggle"/>
                        </group>
                        <notebook>
                            <!-- Postal Address tab -->
                            <page string="Postal Addresses">
                                <field name="postal_address_ids" widget="one2many_list">
                                    <list editable="bottom">
                                        <field name="tripletex"/>
                                        <field name="street"/>
                                        <field name="street2"/>
                                        <field name="zip"/>
                                        <field name="city"/>
                                        <field name="country"/>
                                        <field name="country_code"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Delivery Address tab -->
                            <page string="Delivery Addresses">
                                <field name="delivery_address_ids" widget="one2many_list">
                                    <list editable="bottom">
                                        <field name="tripletex"/>
                                        <field name="street"/>
                                        <field name="street2"/>
                                        <field name="zip"/>
                                        <field name="city"/>
                                        <field name="country"/>
                                        <field name="country_code"/>
                                    </list>
                                </field>
                            </page>

                        <!-- Business Address tab -->
                            <page string="Business Addresses">
                                <field name="business_address_ids" widget="one2many_list">
                                    <list editable="bottom">
                                        <field name="tripletex"/>
                                        <field name="street"/>
                                        <field name="street2"/>
                                        <field name="zip"/>
                                        <field name="city"/>
                                        <field name="country"/>
                                        <field name="country_code"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_create_tripletex_customer_data" model="ir.actions.act_window">
            <field name="name">Create Customer</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tripletex.consumer</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
